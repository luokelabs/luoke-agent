{
  "accessory": "luoke-mem",
  "bundle_id": "ai.luoke.memory",
  "capabilities": {
    "actions": [
      {
        "name": "mem_reply",
        "title": "交回你对记忆的问题、建议的回答",
        "writes": true
      },
      {
        "name": "mem_note",
        "title": "确认、否定、改写、拆出或忘掉记忆里的一条",
        "writes": true
      },
      {
        "name": "mem_forget_tool",
        "title": "忘掉某个应用写进记忆的",
        "writes": true
      },
      {
        "name": "mem_learn",
        "title": "让记忆不再从某个应用学，或者再从它学",
        "writes": true
      },
      {
        "name": "mem_forget_all",
        "title": "清空整份记忆",
        "writes": true
      },
      {
        "name": "mem_person",
        "title": "给记忆里的人改名、并成一个、拆开，说不是一个人，或者忘掉这个人",
        "writes": true
      },
      {
        "name": "mem_archive",
        "title": "把记忆想问的事、建议归档，或者放回去",
        "writes": true
      }
    ],
    "data": [
      "recent",
      "helped",
      "asks",
      "ask",
      "notes",
      "people",
      "person",
      "note",
      "sources",
      "data",
      "forget"
    ],
    "protocol": 1,
    "reports": [
      {
        "kind": "question",
        "title": "记忆想问的事",
        "urgency": "normal"
      },
      {
        "kind": "suggestion",
        "title": "记忆的建议",
        "urgency": "normal"
      }
    ],
    "service": {
      "pages": [
        {
          "id": "overview",
          "title": "概览"
        },
        {
          "id": "all",
          "title": "全部记忆"
        },
        {
          "id": "people",
          "title": "人物"
        },
        {
          "hidden": true,
          "icon": "settings",
          "id": "settings",
          "title": "设置"
        },
        {
          "hidden": true,
          "id": "item",
          "title": "一条理解"
        },
        {
          "hidden": true,
          "id": "asks",
          "title": "归档的问题"
        },
        {
          "hidden": true,
          "id": "guesses",
          "title": "待确认"
        },
        {
          "hidden": true,
          "id": "kept",
          "title": "全部记忆"
        },
        {
          "hidden": true,
          "id": "sources",
          "title": "设置"
        }
      ],
      "summary": true,
      "ui": {
        "open": "mem_open"
      }
    },
    "transport": "stdio"
  },
  "commands": {
    "forget-tool": [
      "-m",
      "luoke_mem",
      "--path",
      "{memory}",
      "forget-tool",
      "{tool}"
    ],
    "mcp": [
      "-m",
      "luoke_mem",
      "--path",
      "{memory}",
      "mcp"
    ]
  },
  "contract": 1,
  "data": [],
  "entry": [
    "-m",
    "luoke_mem",
    "app"
  ],
  "jobs": [
    {
      "allow_battery": false,
      "command": [
        "-m",
        "luoke_mem",
        "--path",
        "{memory}",
        "learn"
      ],
      "memory_mb": 100,
      "min_interval_minutes": 120,
      "name": "learn",
      "timeout_minutes": 30,
      "title": "整理记忆",
      "uses_model": true
    }
  ],
  "memory": false,
  "name": "螺壳记忆",
  "resident": false,
  "tasks": [
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mem.typing"
    },
    {
      "kind": "generate",
      "main": false,
      "name": "luoke-mem.topics"
    }
  ],
  "type": "component",
  "ui_element": true,
  "version": "0.44.0"
}
