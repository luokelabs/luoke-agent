        "value": {
         "path": "/checks/sure"
        }
       },
       {
        "component": "Text",
        "id": "t3",
        "text": "邮件助手：记录 9 条，理解 3 条"
       },
       {
        "action": {
         "event": {
          "context": {
           "sure": {
            "path": "/checks/sure"
           },
           "tool": "luoke-mail"
          },
          "name": "mem_forget_tool"
         }
        },
        "child": "b4-text",
        "component": "Button",
        "id": "b4",
